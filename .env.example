# Environment
NODE_ENV=production

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=protistore
DB_PASS=CHANGE_ME
DB_NAME=vibestore

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME

# Server
SERVER_PORT=8081

# CORS — comma-separated domains allowed
CORS_DOMAINS=protistore.com,localhost

# Cookie domain — set for subdomain sharing (e.g. ".protistore.com")
# Leave empty for localhost/dev
COOKIE_DOMAIN=.protistore.com

# File Uploads (absolute path in production)
UPLOAD_DIR=/home/ubuntu/protistore/uploads

# S3 Image Upload (leave empty to use local file upload)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Email (SMTP) — leave SMTP_HOST empty to disable email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@protistore.com
